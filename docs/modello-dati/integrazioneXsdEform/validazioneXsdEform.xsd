<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
           xmlns:efbc="http://data.europa.eu/p27/eforms-ubl-extension-basic-components/1"
           targetNamespace="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
           elementFormDefault="qualified">
	<!-- Date: YYYY-MM-DDZ -->
	<xs:simpleType name="DateWithZType">
		<xs:restriction base="xs:string">
			<xs:pattern value="^((((1[6-9]|[2-9]\d)\d{2})-(((0[13578]|1[02]))-31|((0[13-9]|1[0-2])-(29|30))))|(((((1[6-9]|[2-9]\d)(0[48]|[2468][048]|[13579][26])|((16|[2468][048]|[3579][26])00)))-02-29))|(((1[6-9]|[2-9]\d)\d{2})-((0[1-9])|(1[0-2]))-(0[1-9]|1\d|2[0-8])))(Z|[-+]((0[0-9]|1[0-3]):([03]0|45)|14:00))$"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Time: HH:MM:SSZ -->
	<xs:simpleType name="TimeWithZType">
		<xs:restriction base="xs:string">
			<xs:pattern value="^(([01]\d|2[0-3])((:[0-5]\d){1,2}(\.\d+)?)?)(Z|[-+]((0[0-9]|1[0-3]):([03]0|45)|14:00))$"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Amount: intero + '.' + due decimali obbligatori -->
	<xs:simpleType name="AmountWithDecimalsType">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d+(\.\d{2})"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Elementi da validare -->
	<xs:element name="cbc:EndDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:IssueDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:OccurrenceDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:PlannedDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:StartDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:AwardDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:RequestedPublicationDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:LatestSecurityClearanceDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:Date"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:RegistrationDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="efbc:WithdrawnAppealDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="efbc:PublicationDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="efbc:ProcurementDocumentsChangeDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="efbc:TransmissionDate"
	            type="cbc:DateWithZType"/>
	<xs:element name="cbc:IssueTime"
	            type="cbc:TimeWithZType"/>
	<xs:element name="cbc:EndTime"
	            type="cbc:TimeWithZType"/>
	<xs:element name="cbc:OccurrenceTime"
	            type="cbc:TimeWithZType"/>
	<xs:element name="efbc:TransmissionTime"
	            type="cbc:TimeWithZType"/>
	<xs:element name="cbc:EstimatedOverallContractAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:EstimatedMaximumValueAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:TotalAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:ValueAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:MaximumValueAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:LowerTenderAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:HigherTenderAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:PayableAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:PaidAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="cbc:FeeAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:OverallApproximateFrameworkContractsAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:OverallMaximumFrameworkContractsAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:GroupFrameworkMaximumValueAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:GroupFrameworkReestimatedValueAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:RevenueBuyerAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:RevenueUserAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:FrameworkMaximumAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:TermAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:ReestimatedValueAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:PenaltiesAmount"
	            type="cbc:AmountWithDecimalsType"/>
	<xs:element name="efbc:AppealRemedyValue"
	            type="cbc:AmountWithDecimalsType"/>
</xs:schema>
